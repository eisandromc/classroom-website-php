{
  "name": "webshoes/laravel-didatico",
  "type": "project",
  "description": "WebShoes versao 10 Laravel 13 MVC Eloquent",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
